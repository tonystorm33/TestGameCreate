.learning-root { flex-grow: 1; background-color: rgb(246, 244, 236); color: rgb(45, 49, 70); font-size: 18px; }
.page-scroll { flex-grow: 1; }
.shell { flex-shrink: 0; width: 100%; max-width: 1240px; align-self: center; padding: 28px 48px; }
Label { flex-shrink: 0; white-space: normal; }
Button { flex-shrink: 0; cursor: link; transition-duration: 0.16s; transition-property: background-color, border-color; }
.home, .lesson, .hero, .tools, .cards, .flow, .explanation, .stage, .controls, .pool-lanes, .pool-lane, .progress-track { flex-shrink: 0; }
.page-scroll .unity-scroll-view__content-container { flex-shrink: 0; }
.brand-row { flex-direction: row; align-items: center; margin-bottom: 26px; }
.brand-mark { width: 42px; height: 42px; border-radius: 14px; background-color: rgb(109, 99, 208); color: white; -unity-text-align: middle-center; -unity-font-style: bold; font-size: 26px; margin-right: 12px; }
.brand-title { font-size: 21px; -unity-font-style: bold; }
.brand-caption { flex-grow: 1; -unity-text-align: middle-right; font-size: 14px; color: rgb(113, 115, 130); }
.hero { background-color: rgb(233, 228, 254); border-radius: 26px; padding: 26px 32px; border-bottom-width: 5px; border-bottom-color: rgb(208, 197, 239); margin-bottom: 24px; }
.eyebrow { font-size: 14px; -unity-font-style: bold; color: rgb(114, 100, 170); margin-bottom: 10px; }
.hero-title { font-size: 34px; -unity-font-style: bold; margin-bottom: 12px; }
.body { font-size: 18px; color: rgb(82, 87, 107); margin-bottom: 18px; white-space: normal; }
.progress-caption { font-size: 14px; color: rgb(115, 100, 161); margin-top: 10px; }
.tools { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 20px; flex-wrap: wrap; }
.filters { flex-direction: row; flex-wrap: wrap; }
.filter { padding: 9px 18px; border-width: 0; border-radius: 18px; margin-right: 6px; margin-bottom: 6px; background-color: rgb(235, 233, 227); color: rgb(100, 102, 117); font-size: 16px; }
.filter.selected { background-color: rgb(109, 99, 208); color: white; }
.search { width: 270px; margin-bottom: 6px; font-size: 15px; }
.search > .unity-text-field__label { min-width: 64px; }
.search .unity-text-field__input { border-radius: 10px; padding: 8px; background-color: white; color: rgb(45, 49, 70); }
.cards { flex-direction: row; flex-wrap: wrap; }
.knowledge-card { flex-direction: column; flex-shrink: 0; width: 31%; min-height: 250px; margin: 0 2% 22px 0; padding: 22px; align-items: stretch; background-color: white; color: rgb(45, 49, 70); border-width: 2px 2px 5px 2px; border-color: rgb(227, 223, 213); border-radius: 22px; white-space: normal; }
.knowledge-card:hover { background-color: rgb(252, 250, 255); border-color: rgb(166, 151, 220); }
.knowledge-card:focus { border-color: rgb(109, 99, 208); }
.card-ribbon { flex-direction: row; align-items: center; margin-bottom: 18px; }
.badge { width: 54px; height: 46px; border-radius: 15px; -unity-text-align: middle-center; color: white; font-size: 18px; -unity-font-style: bold; margin-right: 12px; }
.category { font-size: 14px; color: rgb(121, 125, 143); }
.card-title { font-size: 24px; -unity-font-style: bold; margin-bottom: 10px; -unity-text-align: upper-left; }
.card-summary { font-size: 16px; color: rgb(112, 116, 136); flex-grow: 1; margin-bottom: 22px; -unity-text-align: upper-left; }
.card-link { font-size: 15px; -unity-font-style: bold; color: rgb(109, 99, 208); -unity-text-align: upper-left; }
.footer { font-size: 14px; color: rgb(130, 131, 141); margin-top: 12px; margin-bottom: 14px; }
.back { align-self: flex-start; background-color: rgb(232, 226, 251); color: rgb(94, 80, 167); border-width: 0; border-radius: 14px; padding: 12px 20px; font-size: 17px; margin-bottom: 24px; }
.stage { border-radius: 24px; padding: 28px; background-color: white; border-width: 2px 2px 5px 2px; border-color: rgb(227, 223, 213); }
.flow { flex-direction: row; flex-wrap: wrap; margin-bottom: 16px; }
.step-node { background-color: rgb(243, 241, 250); color: rgb(98, 97, 131); border-color: rgb(225, 220, 237); border-width: 2px; border-radius: 14px; padding: 12px 16px; margin: 0 8px 10px 0; font-size: 16px; }
.step-node.selected { background-color: rgb(109, 99, 208); border-color: rgb(109, 99, 208); color: white; }
.explanation { border-radius: 18px; padding: 22px; background-color: rgb(248, 247, 252); min-height: 220px; }
.section-title { font-size: 24px; -unity-font-style: bold; margin-bottom: 16px; }
.code { background-color: rgb(49, 54, 80); color: rgb(221, 233, 247); border-radius: 12px; padding: 16px; font-size: 16px; white-space: normal; }
.progress-track { height: 8px; background-color: rgb(238, 235, 246); border-radius: 4px; margin-top: 22px; margin-bottom: 20px; overflow: hidden; }
.progress-fill { height: 8px; border-radius: 4px; transition-property: width; transition-duration: 0.35s; }
.controls { flex-direction: row; flex-wrap: wrap; margin-top: 8px; }
.action, .secondary { border-radius: 14px; padding: 13px 22px; border-width: 0 0 3px 0; margin: 0 10px 10px 0; font-size: 17px; }
.action { background-color: rgb(109, 99, 208); border-color: rgb(80, 69, 173); color: white; }
.action:hover { background-color: rgb(129, 115, 225); }
.secondary { background-color: rgb(237, 235, 247); border-color: rgb(213, 206, 231); color: rgb(98, 88, 142); }
.secondary:hover { background-color: rgb(223, 216, 244); }
.action:disabled, .secondary:disabled { opacity: 0.4; }
.note { background-color: rgb(255, 240, 204); border-radius: 16px; padding: 18px 22px; margin-top: 20px; font-size: 16px; color: rgb(132, 104, 48); }
.pool-lanes { flex-direction: row; margin-top: 6px; margin-bottom: 20px; }
.pool-lane { flex-grow: 1; flex-basis: 0; background-color: rgb(241, 247, 244); border-radius: 18px; padding: 20px; margin-right: 12px; min-height: 185px; }
.balls { flex-direction: row; flex-wrap: wrap; }
.ball { width: 54px; height: 54px; margin: 5px; border-radius: 27px; background-color: rgb(149, 185, 169); color: white; -unity-font-style: bold; -unity-text-align: middle-center; font-size: 20px; }
.ball.working { background-color: rgb(241, 158, 97); }
.pool-status { font-size: 18px; margin-bottom: 20px; color: rgb(87, 126, 106); }
.empty { padding: 40px; color: rgb(112, 116, 136); }
.compact .shell { padding: 20px; }
.compact .brand-caption { display: none; }
.compact .knowledge-card { width: 48%; }
.compact .hero-title { font-size: 28px; }
.compact .pool-lanes { flex-direction: column; }
.compact .pool-lane { margin-bottom: 12px; }
.learning-overview { background-color: rgb(236, 245, 240); border-radius: 16px; padding: 20px; margin-bottom: 22px; font-size: 17px; color: rgb(63, 105, 87); }
.lesson-section, .lesson-warning, .lesson-exercise { border-radius: 14px; padding: 18px; margin-bottom: 16px; font-size: 17px; }
.lesson-section { background-color: rgb(235, 241, 254); color: rgb(66, 89, 132); }
.lesson-warning { background-color: rgb(255, 243, 220); color: rgb(126, 95, 45); }
.lesson-exercise { background-color: rgb(232, 246, 240); color: rgb(58, 111, 88); }
.code-scroll { flex-shrink: 0; max-height: 380px; margin-bottom: 18px; background-color: rgb(49, 54, 80); border-radius: 12px; }
.code-scroll .code { font-size: 15px; white-space: nowrap; }
.reading-speed { flex-shrink: 0; margin: 8px 0 24px 0; max-width: 580px; }
.references { font-size: 14px; color: rgb(120, 119, 142); margin-top: 18px; }
.chapter-count { font-size: 13px; color: rgb(121, 125, 143); margin-bottom: 12px; }
